APP_NAME="Siya's Kitchen"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/London
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=suyas_kitchen
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@suyaskitchen.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

# Restaurant Information & Settings
RESTAURANT_NAME="Siya's Kitchen"
RESTAURANT_TAGLINE="by Jalaram Group"
RESTAURANT_SUBTITLE="Authentic Indian Cuisine • Harrow, London"
RESTAURANT_LOCATION="Harrow, London"
RESTAURANT_ADDRESS="453 Alexandra Avenue, Harrow, Middx HA2 9SE"
RESTAURANT_PHONE="02082594954"
RESTAURANT_EMAIL="siyaskitchen9@gmail.com"
RESTAURANT_CURRENCY_CODE=GBP
RESTAURANT_CURRENCY_SYMBOL="£"

# Opening Hours
RESTAURANT_HOURS_MON_THU="12:00 PM – 10:00 PM"
RESTAURANT_HOURS_FRI_SAT="12:00 PM – 11:00 PM"
RESTAURANT_HOURS_SUN="12:00 PM – 9:30 PM"

# Payment & POS Integration Architecture Placeholders
PAYMENT_DRIVER=stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

POS_DRIVER=placeholder
POS_API_URL=
POS_API_KEY=

VITE_APP_NAME="${APP_NAME}"
