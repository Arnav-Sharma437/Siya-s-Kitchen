<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ /index.php [L]
</IfModule>

<IfModule mod_php7.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 20M
    php_value memory_limit 256M
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 20M
    php_value memory_limit 256M
</IfModule>
